# ══════════════════════════════════════════════════════════════════════════
#  CONFIGURACIÓN DE YUNATT — Módulo RRHH Lost Children Perú
# ══════════════════════════════════════════════════════════════════════════
#
#  CÓMO USAR ESTE ARCHIVO
#    1. Copia este archivo como  backend/.env   (mismo directorio)
#    2. Rellena los valores tú mismo
#    3. NO subas backend/.env a git — solo este .example
#
#  El backend NO arranca comandos hacia yunatt si faltan EMAIL/PASSWORD:
#  se queda en modo "sin credenciales" y la interfaz lo indica claramente.
# ══════════════════════════════════════════════════════════════════════════


# ── Credenciales de la cuenta de yunatt.com ───────────────────────────────
# Es la MISMA cuenta que usa el ERP anterior (decisión de migración).
# Ver la advertencia sobre sesiones concurrentes al final de este archivo.
YUNATT_EMAIL=
YUNATT_PASSWORD=


# ── Dispositivo biométrico ────────────────────────────────────────────────
# attenceMachineId del Timmy TM-AI03F (identificador numérico interno de
# yunatt, NO el número de serie).
#
# Dónde encontrarlo: en el panel de yunatt.com, sección de dispositivos;
# el id aparece en la URL o en el HTML de la fila del equipo.
#
# Es el MISMO equipo físico que ya usa el ERP anterior, así que el id es el
# mismo que tiene configurado ese sistema.
YUNATT_DEVICE_ID=


# ── Departamento NUEVO (separado de producción) ───────────────────────────
# Basta con crear el departamento en el panel de yunatt.com con ESTE MISMO
# nombre. El backend resuelve su id numérico solo, consultando la lista de
# departamentos al dar de alta a alguien: el id no aparece por ningún lado
# en la interfaz web de yunatt, así que pedírtelo no tenía sentido.
#
# Todo lo que enrole este sistema cae en ese departamento. Así distingues
# de un vistazo en yunatt qué entró por el sistema nuevo y qué por el
# viejo, y puedes limpiar o auditar uno sin tocar el otro.
YUNATT_DEPT_NAME=RRHH-Nuevo

# Opcional. Déjalo VACÍO salvo que quieras forzar un id concreto y saltarte
# la búsqueda por nombre (por ejemplo si algún día hay dos departamentos
# con el mismo nombre). El departamento que usa el ERP anterior NO va aquí.
YUNATT_DEPT_ID=


# ── Servidor local ────────────────────────────────────────────────────────
PUERTO=7801


# ══════════════════════════════════════════════════════════════════════════
#  AVISO — SESIONES CONCURRENTES DURANTE LA TRANSICIÓN
# ══════════════════════════════════════════════════════════════════════════
#  Mientras el ERP anterior siga encendido, ambos sistemas se autentican
#  contra la misma cuenta de yunatt. yunatt puede invalidar la sesión más
#  antigua al abrirse una nueva, y cada sistema se re-loguea solo al
#  detectarlo.
#
#  Este backend minimiza el solape: login perezoso (solo al enrolar de
#  verdad), sin hilos de sincronización en segundo plano, y re-login con
#  espera progresiva en vez de reintento agresivo.
#
#  Aun así, lo ideal es no tener los dos sistemas enrolando a la vez.
#  Para consultar y navegar no hay problema.
# ══════════════════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════════════════
#  FORMULARIO PÚBLICO DE TUTORES  (opcional)
# ══════════════════════════════════════════════════════════════════════════
#
#  Sin esto, el resto del sistema funciona igual: solo se desactiva la
#  entrega de enlaces del formulario y la traída de respuestas.
#
#  El enlace prerrellenado que da Google, con la palabra PLANTILLA donde va
#  el código de cada familia. Se copia del editor del formulario:
#  ⋮ -> "Obtener enlace prerrellenado". No se arma a mano: el número de
#  campo (entry.NNNNNNN) lo asigna Google y cambia si se rehace la pregunta.
FORM_URL_PRELLENADO=
FORM_MARCA_TOKEN=PLANTILLA

#  Identificador de la hoja de respuestas: la tira entre /d/ y /edit en su
#  dirección.
FORM_HOJA_ID=

#  Cuánto vale un enlace entregado, en días.
FORM_DIAS_VIGENCIA=30

#  Ruta a la llave de la cuenta de servicio de Google que lee esa hoja
#  (JSON descargado de console.cloud.google.com). El archivo NO se versiona:
#  la carpeta data/credenciales/ está excluida en .gitignore.
FORM_CREDENCIAL=data/credenciales/google-hoja-respuestas.json
