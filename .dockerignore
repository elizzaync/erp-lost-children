.git
.gitignore

# Python
__pycache__/
*.pyc
*.pyo
.venv/
bridge/.venv/

# Logs
*.log
*.log.err

# Secretos y datos sensibles — NUNCA deben hornearse en la imagen. En
# producción se montan como volúmenes o se inyectan como variables de
# entorno desde el panel de Coolify.
bridge/.env
bridge/ssl/
bridge/static/fotos/
bridge/static/comprobantes/
bridge/static/articulos/
static/fotos/

# Documentación / auditoría (no forma parte de la app en runtime)
docs/*.docx
docs/~$*

# Windows
Thumbs.db
Desktop.ini
iniciar_bridge.bat

# Frontend (Vite) — se instala/compila DENTRO del build stage de Node, nunca
# copiando lo que haya en el host (node_modules del host puede tener binarios
# nativos de otra plataforma; dist/ del host puede estar desactualizado).
frontend/node_modules/
frontend/dist/
